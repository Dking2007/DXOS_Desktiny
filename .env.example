# Reference only. Run `python scripts/bootstrap.py` to generate local values.
# Never deploy production with this development Compose unchanged.
PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_PORT=8080
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
CORE_DB_PASSWORD=REPLACE_WITH_RANDOM
WORKSPACE_DB_PASSWORD=REPLACE_WITH_RANDOM
IDENTITY_DB_PASSWORD=REPLACE_WITH_RANDOM
KEYCLOAK_ADMIN=dx-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM
WORKSPACE_CLIENT_SECRET=REPLACE_WITH_RANDOM
CORE_ADMIN_CLIENT_SECRET=REPLACE_WITH_RANDOM
WORKSPACE_SERVICE_CLIENT_SECRET=REPLACE_WITH_RANDOM
CORE_EXAMPLE_CLIENT_SECRET=REPLACE_WITH_RANDOM
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
S3_ACCESS_KEY=REPLACE_WITH_RANDOM
S3_SECRET_KEY=REPLACE_WITH_RANDOM
ONLYOFFICE_JWT_SECRET=REPLACE_WITH_RANDOM
ONLYOFFICE_ENABLED=false
# Hostnames automation webhooks may call, comma-separated (e.g. hooks.example.org).
# Empty keeps outbound automation calls disabled.
AUTOMATION_ALLOWED_HOSTS=
# Plugin kết nối: tên máy chủ plugin được phép (cách nhau bởi dấu phẩy, vd. mst.noi-bo.gov.vn) cho Workspace API,
# và origin được hiện trong khung (cách nhau bởi dấu cách, vd. https://mst.noi-bo.gov.vn) cho CSP của gateway.
# Để trống thì không cài được plugin nào.
PLUGIN_ALLOWED_HOSTS=
PLUGIN_FRAME_SOURCES=
# Tuỳ chọn (mặc định như dưới): số lời gọi mỗi phút của một plugin theo kênh, dung lượng tệp plugin gắn vào
# hồ sơ (mỗi tệp, tổng 24 giờ), chu kỳ quét hồ sơ/công việc quá hạn (giây).
# PLUGIN_READS_PER_MINUTE=600
# PLUGIN_WRITES_PER_MINUTE=120
# PLUGIN_NOTIFICATIONS_PER_MINUTE=30
# PLUGIN_EVENTS_PER_MINUTE=60
# PLUGIN_UPLOAD_MAX_BYTES=26214400
# PLUGIN_UPLOAD_DAILY_BYTES=209715200
# OVERDUE_SWEEP_SECONDS=300
# Máy chủ thư cho bước "Gửi email" trong luồng; để trống thì bước này bị từ chối.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Cổng LLM nội bộ/HTTP được trợ lý AI dùng (cách nhau dấu phẩy). Cổng HTTPS công khai không cần khai.
# Máy chủ Ollama/vLLM tự cài không cần khai: nhập thẳng địa chỉ nội bộ trong màn Trợ lý AI.
ASSISTANT_ALLOWED_HOSTS=
# Compose reads this as ${COOKIE_SECURE:-false}; bootstrap writes true only for an
# https:// --base-url. Leave false for local HTTP development.
COOKIE_SECURE=false
# --- Tuỳ chọn (mặc định trong mã đã đủ cho dev; bỏ comment để đổi) ---
# Chuỗi kết nối PostgreSQL, dạng như BUILD.md; mỗi dịch vụ một CSDL riêng. Mã có mặc định cho từng dịch vụ.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/db
# Thư mục gói ngành. Để trống = tự tìm: packs/ cạnh mã nguồn, rồi $PREFIX/share/desktiny/packs (bản make install), rồi /app/packs.
# PACKS_DIR=
# Tên dịch vụ trong nhật ký (workspace-api tự đặt workspace).
# SERVICE_NAME=core
# development hoặc production; production bắt buộc HTTPS, COOKIE_SECURE=true và STORAGE_BACKEND=s3.
# ENVIRONMENT=development
# Địa chỉ nội bộ của cổng dùng để gọi giữa các dịch vụ.
# INTERNAL_BASE_URL=http://gateway
# Nhà phát hành và địa chỉ SSO (OIDC). Trình duyệt dùng OIDC_ISSUER; dịch vụ gọi nội bộ dùng OIDC_INTERNAL_URL.
# OIDC_ISSUER=http://localhost:8080/identity/realms/dx
# OIDC_INTERNAL_URL=http://localhost:8080/identity
# Client và audience OIDC (core-api: core-admin / dx-core; workspace-api: workspace / dx-workspace).
# OIDC_CLIENT_ID=core-admin
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=dx-core
# Client ID của tài khoản dịch vụ workspace (dùng cùng WORKSPACE_SERVICE_CLIENT_SECRET).
# WORKSPACE_SERVICE_CLIENT_ID=workspace-service
# Nguồn gốc (origin) được phép gọi API, cách nhau bởi dấu phẩy.
# ALLOWED_ORIGINS=http://localhost:8080
# Thời hạn phiên đăng nhập (giây).
# SESSION_TTL_SECONDS=28800
# Địa chỉ nội bộ của core-api (workspace-api gọi sang).
# CORE_API_URL=http://localhost:8001
# Kho tệp S3 (endpoint, bucket). STORAGE_BACKEND: s3 hoặc local (local chỉ cho dev).
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=dx-files
# STORAGE_BACKEND=s3
# STORAGE_LOCAL_PATH=.data/blobs
# Dung lượng tệp tối đa (byte) và thời hạn vé tải xuống (giây).
# MAX_UPLOAD_BYTES=52428800
# DOWNLOAD_TICKET_SECONDS=120
# Địa chỉ ONLYOFFICE: công khai (trình duyệt) và nội bộ (máy chủ gọi).
# ONLYOFFICE_PUBLIC_URL=http://localhost:8080/office
# ONLYOFFICE_INTERNAL_URL=http://onlyoffice
# Số bước tối đa của một quy trình (1 đến 1000).
# WORKFLOW_MAX_STEPS=100
# Tài khoản dịch vụ của workspace-api trong SSO.
# WORKSPACE_SERVICE_SUBJECT=workspace-service
# Chu kỳ hỏi hàng đợi công việc (giây) và số lần thử tối đa của worker.
# WORKER_POLL_SECONDS=2.0
# WORKER_MAX_ATTEMPTS=12
# Quét mã độc ClamAV khi tải tệp lên Core. Trống = tắt quét. Bật: chạy compose với --profile antivirus và đặt CLAMAV_HOST=clamav.
# Đã cấu hình mà clamd không phản hồi thì tệp bị từ chối (fail-closed).
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=30
